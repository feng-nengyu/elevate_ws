  """Regression checks for the TCP value shared by driver and MoveIt."""

  from pathlib import Path
  import re

  import pytest


  REPOSITORY_ROOT = Path(__file__).resolve().parents[2]
  EXPECTED_TCP_OFFSET_Z = 0.1468


  def _read(relative_path):
      return (REPOSITORY_ROOT / relative_path).read_text(encoding='utf-8')


  def _first_float(pattern, text):
      match = re.search(pattern, text)
      assert match is not None
      return float(match.group(1))


  def test_driver_and_launch_defaults_share_calibrated_tcp_offset():
      """The live launch path must not silently override driver geometry."""
      driver = _read('piper/piper/piper_ctrl_single_node.py')
      driver_launch = _read('piper/launch/start_single_piper.launch.py')
      system_launch = _read('piper_launch/launch/all.launch.py')

      values = (
          _first_float(
              r"declare_parameter\('tcp_offset_z',\s*([0-9.]+)\)",
              driver,
          ),
          _first_float(
              r"'tcp_offset_z',\s*default_value='([0-9.]+)'",
              driver_launch,
          ),
          _first_float(
              r"'tcp_offset_z',\s*default_value='([0-9.]+)'",
              system_launch,
          ),
      )
    
      assert values == pytest.approx((EXPECTED_TCP_OFFSET_Z,) * 3)


  def test_moveit_uses_description_xacro_with_the_same_tcp_link():
      """The MoveIt config imports the description with calibrated tcp_link."""
      description = _read('piper_description/urdf/piper_description.xacro')
      moveit_xacro = _read(
          'piper_moveit/piper_with_gripper_moveit/config/piper.urdf.xacro'
      )
      tcp_joint = re.search(
          r'<joint name="gripper_base_to_tcp".*?</joint>',
          description,
          flags=re.DOTALL,
      )

      assert tcp_joint is not None
      tcp_value = _first_float(
          r'<origin xyz="0 0 ([0-9.]+)"',
          tcp_joint.group(0),
      )
      assert tcp_value == pytest.approx(EXPECTED_TCP_OFFSET_Z)
      assert (
          '$(find piper_description)/urdf/piper_description.xacro'
          in moveit_xacro
      )

